{
  "expo": {
    "name": "Onesa Robot",
    "slug": "onesa-robot",
    "version": "0.1.0",
    "scheme": "onesarobot",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "eu.onesa.robot",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "eu.onesa.robot",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "updates": {
      "enabled": false
    }
  }
}
